{
  "name": "bible-story-pals",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (English/Spanish) Bible story game for pre-K and kindergarten.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node tests/play-through.mjs && node tests/voices.test.mjs && node tests/native.test.mjs && node tests/pass.test.mjs",
    "test:voices": "node tests/voices.test.mjs",
    "voices": "node tools/voices.mjs",
    "icons": "node tools/make-icons.mjs",
    "ios": "node tools/stage-www.mjs && cap sync ios",
    "ios:open": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "playwright": "^1.50.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  }
}
